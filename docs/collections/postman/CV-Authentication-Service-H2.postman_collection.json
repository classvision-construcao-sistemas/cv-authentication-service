                  "});",
                  "",
                  "var response = pm.response.json();",
                  "if (response && response.id) {",
                  "    pm.collectionVariables.set('instituicaoId', response.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Instituto Federal Goiano - Campus Urutai\",\n  \"cnpj\": \"10.651.417/0005-00\",\n  \"telefone\": \"(64) 3465-1900\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/instituicoes/cadastrar-instituicao",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "instituicoes", "cadastrar-instituicao"]
            },
            "description": "Cadastra uma instituicao e salva o id retornado na variavel `instituicaoId`."
          }
        },
