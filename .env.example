# Copie este arquivo para .env e preencha os valores.
# O .env nao e versionado. No Railway, cadastre estas mesmas variaveis no servico.

# MySQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Segredo de assinatura dos tokens JWT (minimo 64 caracteres)
# Gere um com: openssl rand -base64 64
JWT_SECRET=
